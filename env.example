# Google PageSpeed Insights API key (create at console.cloud.google.com, restrict to PSI API)
PSI_API_KEY=your-key-here

# Server port
PORT=3000

# Score below this triggers ALERT status
SCORE_THRESHOLD=70

# Cron schedule for scans (default: every 6 hours)
SCAN_CRON=0 */6 * * *

# Path to the SQLite database file
DB_PATH=./data/psi.db