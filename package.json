{
  "name": "psi-monitor",
  "version": "1.1.0",
  "description": "Self-hosted Performance Monitor for automated Google PageSpeed Insights checks, score history, threshold alerts, and per-site trends.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n css,server -c auto \"npm:dev:css\" \"npm:dev:server\"",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./public/styles.css --watch",
    "dev:server": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/styles.css --minify",
    "test": "npm run build:css && node scripts/check.js",
    "scan": "node src/scanner.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msschermer/psi-monitor.git"
  },
  "keywords": [],
  "author": "Mike Schermer",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/msschermer/psi-monitor/issues"
  },
  "homepage": "https://github.com/msschermer/psi-monitor#readme",
  "dependencies": {
    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "concurrently": "10.0.5",
    "tailwindcss": "4.3.3"
  }
}
